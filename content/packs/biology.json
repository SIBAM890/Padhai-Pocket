  "chunks": [
    {
      "chunk_id": "BSE9-BIO-CELL-S01",
      "concept_id": "cell_structure",
      "title_or": "କୋଷର ସଂରଚନା ଏବଂ ମୁଖ୍ୟ ଅଙ୍ଗିକା",
      "odia_text": "ପ୍ରତ୍ୟେକ ଜୀବ ଶରୀର ଗୋଟିଏ ବା ଏକାଧିକ କୋଷ ଦ୍ୱାରା ଗଠିତ । କୋଷ ହେଉଛି ଜୀବର ମୌଳିକ ଗଠନମୂଳକ ଓ କାର୍ଯ୍ୟକାରୀ ଏକକ । କୋଷଝିଲ୍ଲୀ କୋଷକୁ ଏକ ନିର୍ଦ୍ଦିଷ୍ଟ ଆକାର ଦିଏ ଏବଂ କୋଷଜୀବକରେ ବିଭିନ୍ନ ଅଙ୍ଗିକା ଯଥା ମାଇଟୋକଣ୍ଡ୍ରିଆ ଥାଏ ।",
      "terms": [
        "T_CELL",
        "T_MITO"
      ],
      "source_page": 1,
      "status": "demo_approved",
      "reviewed_by": "Satya"
    },
    {
      "chunk_id": "BSE9-BIO-CELL-S02",
      "concept_id": "cell_division",
      "title_or": "କୋଷ ବିଭାଜନ (ମାଇଟୋସିସ୍ ଏବଂ ମିଓସିସ୍)",
      "odia_text": "ଜୀବର ବୃଦ୍ଧି ଏବଂ କ୍ଷୟପୂରଣ ପାଇଁ କୋଷ ବିଭାଜନ ଆବଶ୍ୟକ । କୋଷ ବିଭାଜନ ମୁଖ୍ୟତଃ ଦୁଇ ପ୍ରକାରର: ମାଇଟୋସିସ୍ (ସମବିଭାଜନ) ଏବଂ ମିଓସିସ୍ (ଅର୍ଦ୍ଧବିଭାଜନ) । ମାଇଟୋସିସ୍ ଦ୍ୱାରା ଶରୀରର କାଇକ କୋଷଗୁଡ଼ିକ ବୃଦ୍ଧି ପାଆନ୍ତି ଏବଂ ଗୋଟିଏ ମାତୃକୋଷରୁ ଦୁଇଟି ସମଗୁଣସଂପନ୍ନ ଅପତ୍ୟ କୋଷ ସୃଷ୍ଟି ହୁଅନ୍ତି ।",
      "terms": [
        "T_MITOSIS",
        "T_MEIOSIS"
      ],
      "source_page": 12,
      "status": "demo_approved",
      "reviewed_by": "Satya"
    },
    {
      "chunk_id": "BSE9-BIO-TISSUE-S01",
      "concept_id": "plant_tissues",
      "title_or": "ଉଦ୍ଭିଦ କଳା (ଭାଜକ କଳା ଓ ସ୍ଥାୟୀ କଳା)",
      "odia_text": "ଉଦ୍ଭିଦ ଶରୀରରେ ଏକ ନିର୍ଦ୍ଦିଷ୍ଟ କାର୍ଯ୍ୟ କରୁଥିବା ସମରୂପୀ କୋଷଗୁଡ଼ିକର ସମୂହକୁ କଳା (Tissue) କୁହାଯାଏ । ଉଦ୍ଭିଦର ବୃଦ୍ଧିଶୀଳ ଅଞ୍ଚଳରେ ଭାଜକ କଳା (Meristematic tissue) ଥାଏ ଯାହାର କୋଷଗୁଡ଼ିକ କ୍ରମାଗତ ବିଭାଜିତ ହୋଇପାରନ୍ତି । ବିଭାଜନ କ୍ଷମତା ହରାଇବା ପରେ ସେଗୁଡ଼ିକ ସ୍ଥାୟୀ କଳା (Permanent tissue) ରେ ପରିଣତ ହୁଅନ୍ତି ।",
      "terms": [
        "T_MERISTEM",
        "T_PERMANENT"
      ],
      "source_page": 24,
      "status": "demo_approved",
      "reviewed_by": "Satya"
    }
  ],
