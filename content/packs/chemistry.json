  "chunks": [
    {
      "chunk_id": "BSE9-CHEM-CARBON-S04",
      "concept_id": "substitution_reaction",
      "title_or": "ପ୍ରତିସ୍ଥାପନ ପ୍ରତିକ୍ରିୟା ଏବଂ ସହସଂଯୋଜକ ବନ୍ଧ",
      "odia_text": "ସୂର୍ଯ୍ୟାଲୋକ ଉପସ୍ଥିତିରେ ମିଥେନ୍ ଓ କ୍ଲୋରିନ୍ ମଧ୍ୟରେ ଦ୍ରୁତ ପ୍ରତିକ୍ରିୟା ଘଟି କ୍ଲୋରିନ୍ ପରମାଣୁଗୁଡ଼ିକ ଗୋଟିଏ ପରେ ଗୋଟିଏ ହାଇଡ୍ରୋଜେନ୍ ପରମାଣୁକୁ ବିସ୍ଥାପିତ କରନ୍ତି । ଏହାକୁ ପ୍ରତିସ୍ଥାପନ ପ୍ରତିକ୍ରିୟା କୁହାଯାଏ ।",
      "terms": [
        "T_SUBST",
        "T_COVALENT"
      ],
      "source_page": 15,
      "status": "demo_approved",
      "reviewed_by": "Satya"
    },
    {
      "chunk_id": "BSE9-CHEM-MATTER-S01",
      "concept_id": "states_of_matter",
      "title_or": "ପଦାର୍ଥର ଅବସ୍ଥା (କଠିନ, ତରଳ ଓ ଗ୍ୟାସୀୟ)",
      "odia_text": "ଆମ ଚାରିପାଖରେ ଥିବା ପଦାର୍ଥ ମୁଖ୍ୟତଃ ତିନୋଟି ଭୌତିକ ଅବସ୍ଥାରେ ଦେଖାଯାଏ: କଠିନ, ତରଳ ଏବଂ ଗ୍ୟାସୀୟ । କଠିନ ପଦାର୍ଥର କଣିକାଗୁଡ଼ିକ ମଧ୍ୟରେ ଆକର୍ଷଣ ବଳ ସର୍ବାଧିକ ଥାଏ ଏବଂ ଏହାର ଏକ ନିର୍ଦ୍ଦିଷ୍ଟ ଆକାର ଓ ଆୟତନ ଥାଏ । ତରଳ ପଦାର୍ଥର ନିର୍ଦ୍ଦିଷ୍ଟ ଆୟତନ ଥାଏ କିନ୍ତୁ ନିର୍ଦ୍ଦିଷ୍ଟ ଆକାର ନଥାଏ । ଗ୍ୟାସୀୟ ପଦାର୍ଥର କଣିକା ମଧ୍ୟରେ ବ୍ୟବଧାନ ସର୍ବାଧିକ ହୋଇଥିବାରୁ ଏହାର ନିର୍ଦ୍ଦିଷ୍ଟ ଆକାର ବା ଆୟତନ ନଥାଏ ।",
      "terms": [
        "T_SOLID",
        "T_LIQUID",
        "T_GAS"
      ],
      "source_page": 5,
      "status": "demo_approved",
      "reviewed_by": "Satya"
    },
    {
      "chunk_id": "BSE9-CHEM-MATTER-S02",
      "concept_id": "evaporation_cooling",
      "title_or": "ବାଷ୍ପୀଭବନ ଏବଂ ଶୀତଳୀକରଣ",
      "odia_text": "ସ୍ଫୁଟନାଙ୍କ ଠାରୁ କମ୍ ଯେକୌଣସି ତାପମାତ୍ରାରେ ତରଳର ଉପରିଭାଗ କଣିକା ବାଷ୍ପରେ ପରିଣତ ହେବା ଘଟଣାକୁ ବାଷ୍ପୀଭବନ (evaporation) କୁହାଯାଏ । ବାଷ୍ପୀଭବନ ସମୟରେ ତରଳର କଣିକାଗୁଡ଼ିକ ଆଖପାଖରୁ ଶକ୍ତି ଶୋଷଣ କରନ୍ତି, ଫଳରେ ଆଖପାଖ ଥଣ୍ଡା ହୋଇଯାଏ । ସେଥିପାଇଁ ଗ୍ରୀଷ୍ମଦିନେ ମାଟି ପାତ୍ରରେ ପାଣି ରଖିଲେ ଥଣ୍ଡା ରହେ ।",
      "terms": [
        "T_EVAP"
      ],
      "source_page": 8,
      "status": "demo_approved",
      "reviewed_by": "Satya"
    },
    {
      "chunk_id": "BSE9-CHEM-ATOM-S01",
      "concept_id": "chemical_combination",
      "title_or": "ରାସାୟନିକ ସଂଯୋଗର ମୌଳିକ ନିୟମ",
      "odia_text": "ରାସାୟନିକ ପରିବର୍ତ୍ତନ ସମୟରେ ବସ୍ତୁତ୍ୱ ସଂରକ୍ଷଣ ନିୟମ ଅନୁଯାୟୀ କୌଣସି ରାସାୟନିକ ପ୍ରତିକ୍ରିୟାରେ ବସ୍ତୁତ୍ୱର ସୃଷ୍ଟି ବା ବିନାଶ ହୋଇପାରିବ ନାହିଁ । ଅନ୍ୟ ଏକ ଗୁରୁତ୍ୱପୂର୍ଣ୍ଣ ନିୟମ ହେଉଛି ସ୍ଥିର ଅନୁପାତ ନିୟମ, ଯେଉଁଥିରେ ଯୌଗିକ ମଧ୍ୟରେ ଥିବା ମୌଳିକଗୁଡ଼ିକ ସର୍ବଦା ଏକ ନିର୍ଦ୍ଦିଷ୍ଟ ବସ୍ତୁତ୍ୱ ଅନୁପାତରେ ଥାଆନ୍ତି ।",
      "terms": [
        "T_MASS_CONS"
      ],
      "source_page": 20,
      "status": "demo_approved",
      "reviewed_by": "Satya"
    }
