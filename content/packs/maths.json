  "chunks": [
    {
      "chunk_id": "BSE9-MATH-REAL-S01",
      "concept_id": "rational_irrational",
      "title_or": "ବାସ୍ତବ ସଂଖ୍ୟା ଏବଂ ପରିମେୟ ସଂଖ୍ୟା",
      "odia_text": "ଯେଉଁ ସଂଖ୍ୟାଗୁଡ଼ିକୁ p/q ଆକାରରେ ପ୍ରକାଶ କରାଯାଇପାରେ ଯେଉଁଠାରେ p ଓ q ପୂର୍ଣ୍ଣ ସଂଖ୍ୟା ଏବଂ q ≠ 0, ସେଗୁଡ଼ିକୁ ପରିମେୟ ସଂଖ୍ୟା (rational number) କୁହାଯାଏ । ସମସ୍ତ ପରିମେୟ ଓ ଅପରିମେୟ ସଂଖ୍ୟାକୁ ଏକତ୍ର ବାସ୍ତବ ସଂଖ୍ୟା କୁହାଯାଏ ।",
      "terms": [
        "T_RATIONAL",
        "T_IRRATIONAL"
      ],
      "source_page": 1,
      "status": "demo_approved",
      "reviewed_by": "Satya"
    },
    {
      "chunk_id": "BSE9-MATH-REAL-S02",
      "concept_id": "real_numbers",
      "title_or": "ବାସ୍ତବ ସଂଖ୍ୟାର ଦଶମିକ ପ୍ରସାରଣ",
      "odia_text": "ପରିମେୟ ସଂଖ୍ୟାର ଦଶମିକ ପ୍ରସାରଣ ସସୀମ (terminating) କିମ୍ବା ଅସୀମ ଆବୃତ୍ତ (non-terminating recurring) ହୋଇଥାଏ । ଯେଉଁ ବାସ୍ତବ ସଂଖ୍ୟାର ଦଶମିକ ପ୍ରସାରଣ ଅସୀମ ଅନାବୃତ୍ତ (non-terminating non-recurring) ହୁଏ, ତାହାକୁ ଅପରିମେୟ ସଂଖ୍ୟା କୁହାଯାଏ । ଉଦାହରଣ ସ୍ୱରୂପ, √2 = 1.4142135... ଏକ ଅପରିମେୟ ସଂଖ୍ୟା ।",
      "terms": [
        "T_TERMINATING",
        "T_NON_TERMINATING"
      ],
      "source_page": 10,
      "status": "demo_approved",
      "reviewed_by": "Satya"
    },
    {
      "chunk_id": "BSE9-MATH-POLY-S01",
      "concept_id": "zeroes_of_polynomial",
      "title_or": "ବହୁପଦୀର ଶୂନ୍ୟ ଏବଂ ସହଗ",
      "odia_text": "ଗୋଟିଏ ବହୁପଦୀ ରାଶି p(x) ରେ ଯଦି x = k ପାଇଁ p(k) = 0 ହୁଏ, ତେବେ 'k' କୁ p(x) ବହୁପଦୀର ଏକ ଶୂନ୍ୟ (Zero) କୁହାଯାଏ । ଏକ ଘାତୀ ବହୁପଦୀ ax + b (a ≠ 0) ର ଗୋଟିଏ ମାତ୍ର ଶୂନ୍ୟ -b/a ଥାଏ । ବହୁପଦୀର ଶୂନ୍ୟ ସଂଖ୍ୟା ତାର ଘାତ (degree) ସହିତ ସମାନ ବା କମ୍ ହୋଇପାରେ ।",
      "terms": [
        "T_ZERO_POLY",
        "T_DEGREE"
      ],
      "source_page": 30,
      "status": "demo_approved",
      "reviewed_by": "Satya"
    }
  ],
